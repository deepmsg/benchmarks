#!/usr/bin/env bash
##
## The C++ build's media driver, in the harness's launcher shape.
##
## Same conversion as `deepmsg-media-driver`: the two property files beside this
## script and any file on the command line become `-Dname=value`; everything
## else passes through. The binary is `DEEPMSG_CPP_DRIVER`, and it is expected
## to be deployed under a short name (default `deepmsg-cpp`) because the
## harness waits on the process's comm with `pgrep -x`, and the kernel truncates
## comm to 15 characters — `deepmsg-media-driver` does not fit.
##
## ★ `deepmsg-cpp` is this build's `apps/deepmsg-media-driver` built with
## `AXC_WITH_DPDK=OFF` (kernel UDP): the cluster harness runs every member over
## the kernel path.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"

if [[ -z "${DEEPMSG_CPP_DRIVER:-}" ]]; then
  echo "deepmsg-cpp-media-driver: set DEEPMSG_CPP_DRIVER (the driver binary)" >&2
  exit 1
fi
if [[ ! -x "${DEEPMSG_CPP_DRIVER}" ]]; then
  echo "deepmsg-cpp-media-driver: no executable driver at ${DEEPMSG_CPP_DRIVER}" >&2
  exit 1
fi

defines=()
passthrough=()

_read_properties() {
  local file=$1 line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%$'\r'}"
    [[ -z "${line// }" ]] && continue
    case "${line}" in \#*) continue ;; esac
    defines+=("-D${line}")
  done <"${file}"
}

_read_properties "${DIR}/low-latency-driver.properties"
_read_properties "${DIR}/benchmark.properties"

for argument in "$@"; do
  if [[ -f "${argument}" ]]; then
    _read_properties "${argument}"
  else
    passthrough+=("${argument}")
  fi
done

exec "${DEEPMSG_CPP_DRIVER}" ${defines[@]+"${defines[@]}"} ${passthrough[@]+"${passthrough[@]}"}
